{
  "name": "klikframe",
  "version": "0.1.0",
  "private": true,
  "description": "KlikFrame photography business SaaS - Next.js App Router + Hono on Vercel.",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/docs-check.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/negative",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "node scripts/e2e-placeholder.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1102.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "jose": "6.2.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "globals": "17.11.0",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
