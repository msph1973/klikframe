# Canonical KlikFrame MVP environment variables (DEPLOYMENT.md §3).
# Real values live only in the Vercel/CI secret store; never commit values
# here. Provider-specific variables stay unset/optional until the owning
# Phase 0 wave (data/provider) wires the corresponding adapter.

APP_ORIGIN=http://localhost:3000

# Neon PostgreSQL / Managed Better Auth (owned by data + provider waves)
DATABASE_URL=
DATABASE_MIGRATION_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Upstash Redis (rate limiting/cache; owned by provider wave)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Civo S3 Object Storage (private object storage; owned by provider wave)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://objectstore.mum1.civo.com
AWS_REGION=mum1
S3_BUCKET=
UPLOAD_CAPABILITY_SECRET=
DATA_ENCRYPTION_KEY=

# Vercel Cron (owned by the integration wave)
CRON_SECRET=

# Resend transactional email (owned by provider wave)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@klikframe.id

# Ably realtime event/invalidation (server-only; owned by provider wave)
ABLY_API_KEY=

# Observability (owned by provider/verifier waves)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
